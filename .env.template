# Copy to .env at your project root and fill in.
# .env should be in your .gitignore.

# === Meta (Facebook) Marketing API ===
# Use a System User token (Meta Business Suite → System Users → Generate Token).
# System User tokens are non-expiring. User tokens expire every 60 days and
# will silently break this skill when they do.
META_PAGE_TOKEN=
META_AD_ACCOUNT_ID=act_

# === Shopify Admin API ===
# Custom app: Shopify Admin → Apps → Develop apps → Create app → API credentials.
# Scopes needed: read_orders, read_products, read_inventory
SHOPIFY_STORE=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_
